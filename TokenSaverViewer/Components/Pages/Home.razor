@page "/"
@using System.IO
@using System.Text.Json
@using TokenStats
@using TokenSaver
@rendermode InteractiveServer

<PageTitle>TokenSaver</PageTitle>

<section class="hero">
    <div class="hero-inner">
        <h1 class="hero-title">TokenSaver</h1>
        <p class="hero-tagline">saving tokens since 2026</p>
        <div class="hero-stat">
            <div class="hero-stat-number">@_totalSaved.ToString("N0")</div>
            <div class="hero-stat-label">total tokens saved</div>
        </div>
        @if (_reports is not null && _reports.Count > 0)
        {
            <div class="hero-meta">
                <span>@_reports.Count tool runs</span>
                <span class="dot">·</span>
                <span>@_avgReduction.ToString("F0")% average reduction</span>
                <span class="dot">·</span>
                <span>≈ $@_dollarsSaved.ToString("F2") saved at Sonnet input rate ($3 per 1M tokens)</span>
            </div>
            <div class="hero-eco" title="Illustrative only — derived from third-party estimates of GPT-class inference. Easily off by 5–10×.">
                <span class="eco-label">Environmental footprint avoided</span>
                <span class="eco-values">
                    @FormatKwh(_kwhSaved)
                    <span class="dot">·</span>
                    @FormatCo2(_co2KgSaved)
                </span>
                <div class="eco-disclaimer">illustrative — ~1 kWh per 1M tokens, US grid avg 0.4 kg CO₂/kWh</div>
            </div>
        }
    </div>
</section>

<section class="report-section">
    <div class="report-header">
        <h2>Activity</h2>
        <div class="report-controls">
            <code class="path">@_path</code>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Load">Reload</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-warning">
            <strong>Couldn't load report:</strong> @_error
            <details class="mt-2">
                <summary>Expected format</summary>
                <pre>@_sampleJson</pre>
            </details>
        </div>
    }
    else if (_reports is null)
    {
        <p><em>Loading…</em></p>
    }
    else if (_reports.Count == 0)
    {
        <p class="text-muted">No entries yet. Run the CLI with <code>--report</code> or invoke an MCP tool to populate it.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>When (UTC)</th>
                    <th>Source</th>
                    <th>Tool</th>
                    <th class="text-end">Without</th>
                    <th class="text-end">With</th>
                    <th class="text-end">Saved</th>
                    <th style="width: 25%;">Reduction</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _reports.OrderByDescending(r => r.Entry.TimestampUtc))
                {
                    var e = row.Entry;
                    var r = row.Report;
                    <tr>
                        <td class="small text-muted">@e.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <span class="badge @(e.Source == "mcp" ? "bg-primary" : "bg-secondary")">
                                @e.Source
                            </span>
                        </td>
                        <td><strong>@r.ToolName</strong></td>
                        <td class="text-end">@r.TokensWithoutTool.ToString("N0")</td>
                        <td class="text-end">@r.TokensWithTool.ToString("N0")</td>
                        <td class="text-end text-success">@r.TokensSaved.ToString("N0")</td>
                        <td>
                            <div class="progress" style="height: 1.25rem;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @r.ReductionPercent.ToString("F0")%;">
                                    @r.ReductionPercent.ToString("F0")%
                                </div>
                            </div>
                        </td>
                        <td class="text-muted small">@r.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<style>
    .hero {
        background: linear-gradient(135deg, #0d2b4e 0%, #1a4a7a 60%, #2d7dd2 100%);
        color: #fff;
        padding: 3rem 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 8px 24px rgba(13, 43, 78, 0.25);
    }

    .hero-inner {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
    }

    .hero-title {
        font-size: 3rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .hero-tagline {
        font-size: 1.1rem;
        opacity: 0.85;
        margin: 0.25rem 0 2rem;
        font-style: italic;
    }

    .hero-stat-number {
        font-size: 4rem;
        font-weight: 800;
        line-height: 1;
        color: #b5f0c4;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        font-variant-numeric: tabular-nums;
    }

    .hero-stat-label {
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        opacity: 0.8;
        margin-top: 0.5rem;
    }

    .hero-meta {
        margin-top: 1.5rem;
        font-size: 0.95rem;
        opacity: 0.85;
    }

    .hero-meta .dot {
        margin: 0 0.6rem;
        opacity: 0.5;
    }

    .hero-eco {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 0.9rem;
    }

    .hero-eco .eco-label {
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        opacity: 0.7;
        font-size: 0.75rem;
        margin-bottom: 0.35rem;
    }

    .hero-eco .eco-values {
        font-size: 1.05rem;
        color: #c8ecd4;
        font-variant-numeric: tabular-nums;
    }

    .hero-eco .eco-disclaimer {
        margin-top: 0.4rem;
        font-size: 0.75rem;
        opacity: 0.55;
        font-style: italic;
    }

    .report-section {
        padding: 0 0.25rem;
    }

    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .report-header h2 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 600;
    }

    .report-controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .report-controls .path {
        font-size: 0.8rem;
        color: #6c757d;
        background: #f4f4f6;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }
</style>

@code {
    private readonly string _path = ReportWriter.DefaultPath;

    private List<Row>? _reports;
    private string? _error;
    private int _totalSaved;
    private double _avgReduction;
    private double _dollarsSaved;
    private double _kwhSaved;
    private double _co2KgSaved;

    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNameCaseInsensitive = true,
    };

    private readonly string _sampleJson = """
        [
          {
            "ToolName": "Focused Emitter",
            "TokensWithoutTool": 7083,
            "TokensWithTool": 3133,
            "Notes": "Bar.cs / FooMethod",
            "Source": "cli",
            "TimestampUtc": "2026-05-11T14:32:18Z"
          }
        ]
        """;

    protected override void OnInitialized() => Load();

    private void Load()
    {
        _error = null;
        _reports = null;
        try
        {
            if (!File.Exists(_path))
            {
                _error = $"File not found at {_path}. Run `roslyn-lean focus ... --report` or invoke the MCP server to create it.";
                return;
            }

            var json = File.ReadAllText(_path);
            var entries = JsonSerializer.Deserialize<List<ReportEntry>>(json, JsonOpts)
                          ?? new List<ReportEntry>();

            _reports = entries.Select(e => new Row(
                e,
                new TokenReport(e.ToolName ?? "(unnamed)", e.TokensWithoutTool, e.TokensWithTool, e.Notes)
            )).ToList();

            _totalSaved = _reports.Sum(r => r.Report.TokensSaved);
            _avgReduction = _reports.Count == 0 ? 0 : _reports.Average(r => r.Report.ReductionPercent);
            _dollarsSaved = _totalSaved / 1_000_000.0 * TokenReport.InputPricePerMillion.Sonnet;
            _kwhSaved = _totalSaved / 1_000_000.0 * TokenReport.EnergyFactors.KwhPerMillionTokens;
            _co2KgSaved = _kwhSaved * TokenReport.EnergyFactors.KgCo2PerKwh;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private sealed record Row(ReportEntry Entry, TokenReport Report);

    private static string FormatKwh(double kwh) => kwh switch
    {
        < 0.001 => $"{kwh * 1_000_000:F0} mWh",
        < 1.0   => $"{kwh * 1_000:F1} Wh",
        < 1_000 => $"{kwh:F2} kWh",
        _       => $"{kwh / 1_000:F2} MWh",
    };

    private static string FormatCo2(double kg) => kg switch
    {
        < 0.001 => $"{kg * 1_000_000:F0} mg CO₂",
        < 1.0   => $"{kg * 1_000:F0} g CO₂",
        < 1_000 => $"{kg:F2} kg CO₂",
        _       => $"{kg / 1_000:F2} t CO₂",
    };
}
