@page "/"
@using System.IO
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using TokenStats
@using TokenSaver
@using TokenSaverViewer
@inject IConfiguration Config
@inject IServiceScopeFactory ScopeFactory
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>TokenSaver</PageTitle>

<section class="hero">
    <div class="hero-inner">
        <h1 class="hero-title">TokenSaver</h1>
        <p class="hero-tagline">saving tokens since 2026</p>
        <div class="hero-stat">
            <div class="hero-stat-number">@_totalSaved.ToString("N0")</div>
            <div class="hero-stat-label">total tokens saved</div>
        </div>
        @if (_runCount > 0)
        {
            <div class="hero-meta">
                <span>@_runCount.ToString("N0") tool runs</span>
                <span class="dot">·</span>
                <span>@_avgReduction.ToString("F0")% average reduction</span>
                <span class="dot">·</span>
                <span>≈ $@_dollarsSaved.ToString("F2") saved at Sonnet input rate ($3 per 1M tokens)</span>
                @if (_distinctClients > 0)
                {
                    <span class="dot">·</span>
                    <span>@_distinctClients.ToString("N0") installs reporting</span>
                }
            </div>
            <div class="hero-eco" title="Illustrative only — derived from third-party estimates of large-model inference. Easily off by 5–10 times.">
                <span class="eco-label">Energy and carbon dioxide you didn't have to spend</span>
                <span class="eco-values">
                    @FormatKwh(_kwhSaved)
                    <span class="dot">·</span>
                    @FormatCo2(_co2KgSaved)
                </span>
                <div class="eco-disclaimer">illustrative — roughly 1 kilowatt-hour per 1 million tokens, United States grid average 0.4 kilograms of carbon dioxide per kilowatt-hour</div>
                <details class="eco-sources">
                    <summary>Sources and methodology</summary>
                    <ul>
                        <li><strong>Energy (~1 kWh per million tokens)</strong> — rough estimate derived from the <a href="https://www.iea.org/reports/electricity-2024" target="_blank" rel="noopener">IEA Electricity 2024</a> report and a Goldman Sachs (2024) analysis of AI data-center demand. Actual inference energy varies widely by model, provider, and hardware — easily 5–10× in either direction.</li>
                        <li><strong>Carbon intensity (0.4 kg CO₂ per kWh)</strong> — United States national grid average from <a href="https://www.epa.gov/egrid" target="_blank" rel="noopener">EPA eGRID 2023</a> (~0.386 kg CO₂e/kWh, rounded to 0.4). The actual figure depends on where the inference provider's data centers are located and the local grid mix.</li>
                        <li><strong>Dollar savings ($3 per million input tokens)</strong> — Claude Sonnet input rate from the <a href="https://www.anthropic.com/pricing" target="_blank" rel="noopener">Anthropic pricing page</a>. Does not account for output tokens, caching, or volume discounts.</li>
                    </ul>
                </details>
            </div>
        }
    </div>
</section>

<section class="report-section">
    <div class="report-header">
        <h2>Activity</h2>
        <div class="report-controls">
            @if (_lastLoaded is not null)
            {
                <span class="updated-at">updated @_lastLoaded.Value.ToLocalTime().ToString("HH:mm:ss")</span>
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-warning">
            <strong>Couldn't load report:</strong> @_error
            @if (_mode == "local")
            {
                <details class="mt-2">
                    <summary>Expected format</summary>
                    <pre>@_sampleJson</pre>
                </details>
            }
        </div>
    }
    else if (_loading && _aggregates.Count == 0)
    {
        <p><em>Loading…</em></p>
    }
    else if (_aggregates.Count == 0)
    {
        <p class="text-muted">No entries yet. Run the CLI with <code>--report</code> or invoke an MCP tool to populate it.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Tool</th>
                    <th>Language</th>
                    <th class="text-end">Runs</th>
                    <th class="text-end">Tokens saved</th>
                    <th style="width: 30%;">Avg reduction</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _aggregates)
                {
                    <tr>
                        <td><strong>@row.ToolName</strong></td>
                        <td>@(string.IsNullOrEmpty(row.Language) ? "—" : row.Language)</td>
                        <td class="text-end">@row.RunCount.ToString("N0")</td>
                        <td class="text-end text-success">@row.TokensSaved.ToString("N0")</td>
                        <td>
                            <div class="progress" style="height: 1.25rem;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @row.AvgReductionPercent.ToString("F0")%;">
                                    @row.AvgReductionPercent.ToString("F0")%
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<style>
    .hero {
        background: linear-gradient(135deg, #0d2b4e 0%, #1a4a7a 60%, #2d7dd2 100%);
        color: #fff;
        padding: 3rem 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 8px 24px rgba(13, 43, 78, 0.25);
    }

    .hero-inner { max-width: 900px; margin: 0 auto; text-align: center; }
    .hero-title { font-size: 3rem; font-weight: 700; margin: 0; letter-spacing: -0.02em; }
    .hero-tagline { font-size: 1.1rem; opacity: 0.85; margin: 0.25rem 0 2rem; font-style: italic; }

    .hero-stat-number {
        font-size: 4rem; font-weight: 800; line-height: 1; color: #b5f0c4;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2); font-variant-numeric: tabular-nums;
    }

    .hero-stat-label {
        font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.15em;
        opacity: 0.8; margin-top: 0.5rem;
    }

    .hero-meta { margin-top: 1.5rem; font-size: 0.95rem; opacity: 0.85; }
    .hero-meta .dot { margin: 0 0.6rem; opacity: 0.5; }

    .hero-eco {
        margin-top: 1.25rem; padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.15); font-size: 0.9rem;
    }

    .hero-eco .eco-label { display: block; opacity: 0.8; font-size: 0.85rem; margin-bottom: 0.35rem; }
    .hero-eco .eco-values { font-size: 1.05rem; color: #c8ecd4; font-variant-numeric: tabular-nums; }
    .hero-eco .eco-disclaimer { margin-top: 0.4rem; font-size: 0.75rem; opacity: 0.55; font-style: italic; }

    .eco-sources { margin-top: 0.5rem; text-align: left; }
    .eco-sources summary {
        cursor: pointer; opacity: 0.6; font-size: 0.75rem; font-style: italic;
        list-style: none; display: block; user-select: none;
    }
    .eco-sources summary::-webkit-details-marker { display: none; }
    .eco-sources summary::before { content: "▶ "; font-style: normal; font-size: 0.7rem; }
    .eco-sources[open] summary::before { content: "▼ "; }
    .eco-sources ul { margin: 0.5rem 0 0 0.75rem; padding: 0; opacity: 0.8; font-size: 0.75rem; line-height: 1.5; }
    .eco-sources li { margin-bottom: 0.4rem; }
    .eco-sources a { color: #b5f0c4; }
    .eco-sources a:hover { color: #fff; }

    .report-section { padding: 0 0.25rem; }

    .report-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;
    }

    .report-header h2 { margin: 0; font-size: 1.4rem; font-weight: 600; }
    .report-controls { display: flex; align-items: center; gap: 0.75rem; }

    .report-controls .path {
        font-size: 0.8rem; color: #6c757d; background: #f4f4f6;
        padding: 0.25rem 0.5rem; border-radius: 4px;
    }

    .updated-at { font-size: 0.8rem; color: #6c757d; }
</style>

@code {
    private const int RefreshSeconds = 30;

    private string _mode = "local";
    private string _source = "";

    private List<AggregateRow> _aggregates = new();
    private string? _error;
    private bool _loading = true;
    private DateTime? _lastLoaded;

    private long _totalSaved;
    private int _runCount;
    private int _distinctClients;
    private double _avgReduction;
    private double _dollarsSaved;
    private double _kwhSaved;
    private double _co2KgSaved;

    private Timer? _refreshTimer;

    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNameCaseInsensitive = true,
    };

    private readonly string _sampleJson = """
        [
          {
            "ToolName": "Focused Emitter",
            "Language": "C#",
            "TokensWithoutTool": 7083,
            "TokensWithTool": 3133,
            "Notes": "Bar.cs / FooMethod",
            "Source": "cli",
            "TimestampUtc": "2026-05-11T14:32:18Z"
          }
        ]
        """;

    protected override async Task OnInitializedAsync()
    {
        _mode = (Config["TokenSaver:Mode"] ?? "local").ToLowerInvariant();
        await Load();

        _refreshTimer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(RefreshSeconds), TimeSpan.FromSeconds(RefreshSeconds));
    }

    public void Dispose() => _refreshTimer?.Dispose();

    private async Task Load()
    {
        try
        {
            if (_mode == "server")
                await LoadFromDb();
            else
                LoadFromFile();

            _dollarsSaved = _totalSaved / 1_000_000.0 * TokenReport.InputPricePerMillion.Sonnet;
            _kwhSaved = _totalSaved / 1_000_000.0 * TokenReport.EnergyFactors.KwhPerMillionTokens;
            _co2KgSaved = _kwhSaved * TokenReport.EnergyFactors.KgCo2PerKwh;
            _error = null;
            _lastLoaded = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadFromDb()
    {
        _source = "tokensaver.db";

        // Scope per load: ReportsDb is scoped, but a Blazor Server circuit is long-lived.
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ReportsDb>();

        var snapshots = await db.ToolLanguageSnapshots.ToListAsync();
        var snapDict  = snapshots.ToDictionary(s => (s.ToolName, s.Language));

        var live = await db.Reports
            .GroupBy(r => new { r.ToolName, r.Language })
            .Select(g => new
            {
                g.Key.ToolName,
                g.Key.Language,
                RunCount     = g.Count(),
                TokensWithout = g.Sum(r => (long)r.TokensWithoutTool),
                TokensWith    = g.Sum(r => (long)r.TokensWithTool),
            })
            .ToListAsync();
        var liveDict = live.ToDictionary(r => (r.ToolName, r.Language));

        var allKeys = snapDict.Keys.Union(liveDict.Keys);
        _aggregates = allKeys
            .Select(key =>
            {
                var s       = snapDict.GetValueOrDefault(key);
                var l       = liveDict.GetValueOrDefault(key);
                var without = (s?.TokensWithoutTotal ?? 0) + (l?.TokensWithout ?? 0);
                var with_   = (s?.TokensWithTotal    ?? 0) + (l?.TokensWith    ?? 0);
                var runs    = (s?.RunCount            ?? 0) + (l?.RunCount      ?? 0);
                var saved   = without - with_;
                var pct     = without == 0 ? 0 : (double)saved / without * 100;
                return new AggregateRow(key.ToolName, key.Language, (int)runs, saved, pct);
            })
            .OrderByDescending(r => r.TokensSaved)
            .ToList();

        var clientsResult = await db.Reports
            .GroupBy(_ => 1)
            .Select(g => new { Clients = g.Select(r => r.ClientId).Distinct().Count() })
            .FirstOrDefaultAsync();

        _distinctClients = clientsResult?.Clients ?? 0;
        _totalSaved  = _aggregates.Sum(r => r.TokensSaved);
        _runCount    = _aggregates.Sum(r => r.RunCount);
        var totalWithout = snapshots.Sum(s => s.TokensWithoutTotal) + live.Sum(l => l.TokensWithout);
        _avgReduction = totalWithout == 0 ? 0 : (double)_totalSaved / totalWithout * 100;
    }

    private void LoadFromFile()
    {
        var path = ReportWriter.DefaultPath;
        _source = path;
        _distinctClients = 0;

        if (!File.Exists(path))
        {
            _aggregates = new();
            _totalSaved = 0; _runCount = 0; _avgReduction = 0;
            _error = $"File not found at {path}. Run `roslyn-lean focus ... --report` or invoke the MCP server to create it.";
            return;
        }

        var json = File.ReadAllText(path);
        var entries = JsonSerializer.Deserialize<List<ReportEntry>>(json, JsonOpts)
                      ?? new List<ReportEntry>();

        _aggregates = entries
            .GroupBy(e => (Tool: e.ToolName ?? "(unnamed)", Lang: e.Language ?? ""))
            .Select(g =>
            {
                var without = g.Sum(e => (long)e.TokensWithoutTool);
                var with = g.Sum(e => (long)e.TokensWithTool);
                var saved = without - with;
                var pct = without == 0 ? 0 : (double)saved / without * 100;
                return new AggregateRow(g.Key.Tool, g.Key.Lang, g.Count(), saved, pct);
            })
            .OrderByDescending(r => r.TokensSaved)
            .ToList();

        _totalSaved = entries.Sum(e => (long)(e.TokensWithoutTool - e.TokensWithTool));
        _runCount = entries.Count;
        var totalWithout = entries.Sum(e => (long)e.TokensWithoutTool);
        _avgReduction = totalWithout == 0 ? 0 : (double)_totalSaved / totalWithout * 100;
    }

    private sealed record AggregateRow(
        string ToolName,
        string Language,
        int RunCount,
        long TokensSaved,
        double AvgReductionPercent);

    private static string FormatKwh(double kwh) => kwh switch
    {
        < 0.001 => $"{kwh * 1_000_000:F0} milliwatt-hours",
        < 1.0   => $"{kwh * 1_000:F1} watt-hours",
        < 1_000 => $"{kwh:F2} kilowatt-hours",
        _       => $"{kwh / 1_000:F2} megawatt-hours",
    };

    private static string FormatCo2(double kg) => kg switch
    {
        < 0.001 => $"{kg * 1_000_000:F0} milligrams of carbon dioxide",
        < 1.0   => $"{kg * 1_000:F0} grams of carbon dioxide",
        < 1_000 => $"{kg:F2} kilograms of carbon dioxide",
        _       => $"{kg / 1_000:F2} tonnes of carbon dioxide",
    };
}
