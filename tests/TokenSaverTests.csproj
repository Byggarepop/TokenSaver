<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RoslynLean.Tests</RootNamespace>
    <AssemblyName>token-saver-tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link the emitter source from the parent project so tests run against the real implementation. -->
    <Compile Include="..\Emitters\FocusedEmitter.cs" Link="Emitters\FocusedEmitter.cs" />
    <Compile Include="..\Emitters\RazorPreprocessor.cs" Link="Emitters\RazorPreprocessor.cs" />
    <Compile Include="..\Emitters\ILanguageEmitter.cs" Link="Emitters\ILanguageEmitter.cs" />
    <Compile Include="..\Emitters\CSharpEmitter.cs" Link="Emitters\CSharpEmitter.cs" />
    <Compile Include="..\Emitters\JsLikeMinifier.cs" Link="Emitters\JsLikeMinifier.cs" />
    <Compile Include="..\Emitters\JavaScriptEmitter.cs" Link="Emitters\JavaScriptEmitter.cs" />
    <Compile Include="..\Emitters\TypeScriptEmitter.cs" Link="Emitters\TypeScriptEmitter.cs" />
    <Compile Include="..\Emitters\PythonEmitter.cs" Link="Emitters\PythonEmitter.cs" />
    <Compile Include="..\Emitters\JsonEmitter.cs" Link="Emitters\JsonEmitter.cs" />
    <Compile Include="..\Emitters\YamlEmitter.cs" Link="Emitters\YamlEmitter.cs" />
    <Compile Include="..\Emitters\XmlEmitter.cs" Link="Emitters\XmlEmitter.cs" />
    <Compile Include="..\Emitters\HtmlEmitter.cs" Link="Emitters\HtmlEmitter.cs" />
    <Compile Include="..\Emitters\CssEmitter.cs" Link="Emitters\CssEmitter.cs" />
    <Compile Include="..\Emitters\CppMinifier.cs" Link="Emitters\CppMinifier.cs" />
    <Compile Include="..\Emitters\CEmitter.cs" Link="Emitters\CEmitter.cs" />
    <Compile Include="..\Emitters\CppEmitter.cs" Link="Emitters\CppEmitter.cs" />
    <Compile Include="..\Emitters\RazorEmitter.cs" Link="Emitters\RazorEmitter.cs" />
    <Compile Include="..\Emitters\VBEmitter.cs" Link="Emitters\VBEmitter.cs" />
    <Compile Include="..\Emitters\VBFocusedEmitter.cs" Link="Emitters\VBFocusedEmitter.cs" />
    <!-- Only include test sources in this folder; ignore razor.cs fixture and any other stray files. -->
    <Compile Remove="AuiGrid.razor.cs" />
    <Compile Remove="fixtures\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.11.0" />
  </ItemGroup>

</Project>
