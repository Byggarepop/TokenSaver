<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RoslynLean.Tests</RootNamespace>
    <AssemblyName>token-saver-tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link the emitter source from the parent project so tests run against the real implementation. -->
    <Compile Include="..\FocusedEmitter.cs" Link="FocusedEmitter.cs" />
    <Compile Include="..\RazorPreprocessor.cs" Link="RazorPreprocessor.cs" />
    <Compile Include="..\ILanguageEmitter.cs" Link="ILanguageEmitter.cs" />
    <Compile Include="..\CSharpEmitter.cs" Link="CSharpEmitter.cs" />
    <Compile Include="..\JsLikeMinifier.cs" Link="JsLikeMinifier.cs" />
    <Compile Include="..\JavaScriptEmitter.cs" Link="JavaScriptEmitter.cs" />
    <Compile Include="..\TypeScriptEmitter.cs" Link="TypeScriptEmitter.cs" />
    <Compile Include="..\PythonEmitter.cs" Link="PythonEmitter.cs" />
    <Compile Include="..\JsonEmitter.cs" Link="JsonEmitter.cs" />
    <Compile Include="..\YamlEmitter.cs" Link="YamlEmitter.cs" />
    <Compile Include="..\XmlEmitter.cs" Link="XmlEmitter.cs" />
    <Compile Include="..\HtmlEmitter.cs" Link="HtmlEmitter.cs" />
    <Compile Include="..\CssEmitter.cs" Link="CssEmitter.cs" />
    <Compile Include="..\CppMinifier.cs" Link="CppMinifier.cs" />
    <Compile Include="..\CEmitter.cs" Link="CEmitter.cs" />
    <Compile Include="..\CppEmitter.cs" Link="CppEmitter.cs" />
    <Compile Include="..\RazorEmitter.cs" Link="RazorEmitter.cs" />
    <!-- Only include test sources in this folder; ignore razor.cs fixture and any other stray files. -->
    <Compile Remove="AuiGrid.razor.cs" />
    <Compile Remove="fixtures\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
  </ItemGroup>

</Project>
