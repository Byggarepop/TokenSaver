@page "/sample"
@using System.Collections.Generic

<h1>Sample Component</h1>
<!-- markup comment to be stripped -->
<div class="container">
    <p>Count: @_count</p>
    <button @onclick="Increment">+1</button>
</div>

@code {
    // line comment in C#
    private int _count = 0;

    /// <summary>Increment the counter.</summary>
    private void Increment()
    {
        _count++;
    }
}
