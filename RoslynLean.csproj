<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RoslynLean</RootNamespace>
    <AssemblyName>roslyn-lean</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- These files are test fixtures or alt integrations from sibling projects (TokenStats, MCP server). Excluded from this minimal CLI build. -->
    <Compile Remove="AuiGrid.razor.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="mcp\**\*.cs" />
    <Compile Remove="expected-output.cs" />
    <Compile Remove="RoslynLean.Program.cs" />
    <Compile Remove="FocusedEmissionTool.cs" />
    <Compile Remove="TokenReport.cs" />
    <Compile Remove="TokenSaverViewer\**\*.cs" />
    <Content Remove="TokenSaverViewer\**" />
    <None Remove="TokenSaverViewer\**" />
    <EmbeddedResource Remove="TokenSaverViewer\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn for parsing and semantic analysis. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <!-- For loading .csproj/.sln so the SemanticModel has all references. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
  </ItemGroup>

</Project>
