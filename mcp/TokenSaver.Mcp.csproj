<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TokenSaver.Mcp</RootNamespace>
    <AssemblyName>tokensaver-mcp</AssemblyName>
    <NoWarn>$(NoWarn);MCP001</NoWarn>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tokensaver-mcp</ToolCommandName>
    <PackageId>TokenSaver.Mcp</PackageId>
    <Version>1.0.0</Version>
    <Authors>sebastianlar</Authors>
    <Description>MCP server for .NET developers — gives AI assistants a token-efficient view of C#, Razor, and .NET project files using the Roslyn compiler platform. Reduces tokens by 50-95% with no loss of logic.</Description>
    <PackageTags>mcp;dotnet;csharp;razor;roslyn;copilot;tokens;llm;tokensaver</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the emitter source with the CLI project (single source of truth). -->
    <Compile Include="..\FocusedEmitter.cs" Link="FocusedEmitter.cs" />
    <Compile Include="..\RazorPreprocessor.cs" Link="RazorPreprocessor.cs" />
    <Compile Include="..\ILanguageEmitter.cs" Link="ILanguageEmitter.cs" />
    <Compile Include="..\CSharpEmitter.cs" Link="CSharpEmitter.cs" />
    <Compile Include="..\JsLikeMinifier.cs" Link="JsLikeMinifier.cs" />
    <Compile Include="..\JavaScriptEmitter.cs" Link="JavaScriptEmitter.cs" />
    <Compile Include="..\TypeScriptEmitter.cs" Link="TypeScriptEmitter.cs" />
    <Compile Include="..\PythonEmitter.cs" Link="PythonEmitter.cs" />
    <Compile Include="..\JsonEmitter.cs" Link="JsonEmitter.cs" />
    <Compile Include="..\YamlEmitter.cs" Link="YamlEmitter.cs" />
    <Compile Include="..\XmlEmitter.cs" Link="XmlEmitter.cs" />
    <Compile Include="..\HtmlEmitter.cs" Link="HtmlEmitter.cs" />
    <Compile Include="..\CssEmitter.cs" Link="CssEmitter.cs" />
    <Compile Include="..\CppMinifier.cs" Link="CppMinifier.cs" />
    <Compile Include="..\CEmitter.cs" Link="CEmitter.cs" />
    <Compile Include="..\CppEmitter.cs" Link="CppEmitter.cs" />
    <Compile Include="..\RazorEmitter.cs" Link="RazorEmitter.cs" />
    <Compile Include="..\ReportWriter.cs" Link="ReportWriter.cs" />
    <Compile Include="..\ReportUploader.cs" Link="ReportUploader.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="ModelContextProtocol" Version="0.3.0-preview.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

</Project>
