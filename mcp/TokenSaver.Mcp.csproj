<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TokenSaver.Mcp</RootNamespace>
    <AssemblyName>tokensaver-mcp</AssemblyName>
    <NoWarn>$(NoWarn);MCP001</NoWarn>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tokensaver-mcp</ToolCommandName>
    <PackageId>TokenSaver.Mcp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Sebastian Larsson</Authors>
    <Description>MCP server for .NET developers — gives AI assistants a token-efficient view of C#, Razor, and .NET project files using the Roslyn compiler platform. Reduces tokens by 50-95% with no loss of logic.</Description>
    <PackageTags>mcp;dotnet;csharp;razor;roslyn;copilot;tokens;llm;tokensaver</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>https://github.com/Byggarepop/TokenSaver/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the emitter source with the CLI project (single source of truth). -->
    <Compile Include="..\Emitters\FocusedEmitter.cs" Link="Emitters\FocusedEmitter.cs" />
    <Compile Include="..\Emitters\RazorPreprocessor.cs" Link="Emitters\RazorPreprocessor.cs" />
    <Compile Include="..\Emitters\ILanguageEmitter.cs" Link="Emitters\ILanguageEmitter.cs" />
    <Compile Include="..\Emitters\CSharpEmitter.cs" Link="Emitters\CSharpEmitter.cs" />
    <Compile Include="..\Emitters\JsLikeMinifier.cs" Link="Emitters\JsLikeMinifier.cs" />
    <Compile Include="..\Emitters\JavaScriptEmitter.cs" Link="Emitters\JavaScriptEmitter.cs" />
    <Compile Include="..\Emitters\TypeScriptEmitter.cs" Link="Emitters\TypeScriptEmitter.cs" />
    <Compile Include="..\Emitters\PythonEmitter.cs" Link="Emitters\PythonEmitter.cs" />
    <Compile Include="..\Emitters\JsonEmitter.cs" Link="Emitters\JsonEmitter.cs" />
    <Compile Include="..\Emitters\YamlEmitter.cs" Link="Emitters\YamlEmitter.cs" />
    <Compile Include="..\Emitters\XmlEmitter.cs" Link="Emitters\XmlEmitter.cs" />
    <Compile Include="..\Emitters\HtmlEmitter.cs" Link="Emitters\HtmlEmitter.cs" />
    <Compile Include="..\Emitters\CssEmitter.cs" Link="Emitters\CssEmitter.cs" />
    <Compile Include="..\Emitters\CppMinifier.cs" Link="Emitters\CppMinifier.cs" />
    <Compile Include="..\Emitters\CEmitter.cs" Link="Emitters\CEmitter.cs" />
    <Compile Include="..\Emitters\CppEmitter.cs" Link="Emitters\CppEmitter.cs" />
    <Compile Include="..\Emitters\RazorEmitter.cs" Link="Emitters\RazorEmitter.cs" />
    <Compile Include="..\Reporting\TokenReport.cs" Link="Reporting\TokenReport.cs" />
    <Compile Include="..\Reporting\ReportWriter.cs" Link="Reporting\ReportWriter.cs" />
    <Compile Include="..\Reporting\ReportUploader.cs" Link="Reporting\ReportUploader.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="ModelContextProtocol" Version="0.3.0-preview.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

</Project>
